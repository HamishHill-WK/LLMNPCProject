# Claude Game Environment Configuration

# Server settings
SECRET_KEY=your_secret_key_here
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Cache settings
MAX_CACHE_SIZE=100
CACHE_EXPIRY_TIME=60

# Game settings
DEFAULT_LOCATION=tavern
DEFAULT_NPC=tavernkeeper
DEFAULT_SIM_NPC=blacksmith

# Memory settings
MAX_SHORT_TERM_MEMORY=3
MAX_LONG_TERM_MEMORY=3
MEMORY_FILE=data/memories.json
DEBUG_MODE=false

# Ollama settings
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
DEFAULT_OLLAMA_MODEL=deepseek-r1:8b
AI_PROVIDER=ollama  # ollama or openai

# OpenAI settings
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_OPENAI_MODEL=gpt-3.5-turbo

# Debug settings
DEBUG_PROMPTS=true